{
  "name": "@cangyeone/dsh-kidcode",
  "version": "0.1.0",
  "description": "少儿编程科普：用 DeepSeek Harness 指挥一台科普地震仪画画，并读懂它的数据。",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-bundle", "kids", "seismology", "education"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "tools",
    "课程",
    "课程表.md",
    "AGENTS.md",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
